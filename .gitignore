# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Lock files of the package managers the website does not use. web/ is pnpm,
# and its pnpm-lock.yaml is committed: CI installs with --frozen-lockfile and
# Vercel installs from it, so dependency versions never drift between them.
package-lock.json
yarn.lock
pnpmfile.js

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output (make build / make links, GoReleaser)
bin/
dist/
completions/

# The playground's WebAssembly build (make web/wasm); rebuilt, never committed
web/public/gnux.wasm
web/public/wasm_exec.js
